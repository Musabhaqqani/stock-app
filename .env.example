# Copy to .env and fill in. Never commit the real .env.

# Neon Postgres. Get both from the Neon console (or `neonctl connection-string`).
# DATABASE_URL: pooled endpoint (host contains "-pooler"), used at runtime.
# DIRECT_URL: unpooled endpoint (same host without "-pooler"), used by Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Any long random string: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=""

# Upstox market data (primary price source). Optional — without it the app
# falls back to the free Yahoo endpoint automatically.
# Use an ANALYTICS token, not a standard access token: standard tokens expire
# daily and the background refresh would silently stop each midnight.
# Read-only market-data scope is sufficient; this app never places orders.
UPSTOX_ACCESS_TOKEN=""

# Sentiment page. Gemini (required): free key from https://aistudio.google.com/apikey.
# Reddit (optional): needs approved API access; news headlines are used without it.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
GEMINI_API_KEY=""
